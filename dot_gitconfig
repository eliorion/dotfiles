[user]
    name = Eliorion
    email = samuel.kharitonoff@edu.esiee.fr

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[branch]
	autoSetupMerge = true
    
[core]
    editor = vim
    autocrlf = input

[alias]
    co = checkout
    br = branch
    cm = commit
    st = status
    lg = log --graph --oneline --all

[worktree]
    # Store worktree .git pointers as relative paths so a worktree stays valid
    # both on the host and inside a devcontainer, which mount the repo at
    # different absolute paths. Requires git >= 2.48.
    useRelativePaths = true
